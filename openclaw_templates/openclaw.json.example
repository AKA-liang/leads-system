{
  "gateway": {
    "mode": "local",
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": [
        "https://claw.example.com"
      ],
      "dangerouslyDisableDeviceAuth": true
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": "${DEEPSEEK_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "reasoning": true,
            "compat": {
              "thinkingFormat": "deepseek"
            }
          },
          {
            "id": "deepseek-v4-pro",
            "name": "DeepSeek V4 Pro",
            "reasoning": true,
            "compat": {}
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "thinkingDefault": "high",
      "model": {
        "primary": "deepseek/deepseek-v4-flash"
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "alias": "DeepSeek"
        }
      }
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.7.1-2",
    "lastTouchedAt": "2026-08-07T10:00:27.023Z"
  },
  "plugins": {
    "allow": [
      "deepseek",
      "openclaw-weixin"
    ],
    "entries": {
      "openclaw-weixin": {
        "enabled": true
      },
      "deepseek": {
        "enabled": true
      }
    }
  },
  "channels": {
    "openclaw-weixin": {
      "channelConfigUpdatedAt": "2026-08-06T01:58:12.753Z"
    }
  }
}